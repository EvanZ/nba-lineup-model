[Unit]
Description=NBA GESTALT Dagster daemon
After=network-online.target gestalt-web.service gestalt-dagster-code-server.service
Wants=network-online.target
Requires=gestalt-dagster-code-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/nba-gestalt/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/nba-gestalt-code/current/src
Environment=DAGSTER_HOME=/var/lib/nba-gestalt/dagster
Environment=AWS_REGION=us-west-1
Environment=GESTALT_AUTOMATIONS_DEFAULT_RUNNING=1
Environment=GESTALT_CURRENT_SEASON_SERVING_ROOT=/var/lib/nba-gestalt/current-season-serving
Environment=GESTALT_CURRENT_SEASON_LINEUPS_ROOT=/var/lib/nba-gestalt/current-season-lineups
Environment=GESTALT_SCHEDULE_STATE_DIR=/var/lib/nba-gestalt/schedule-serving/current
Environment=GESTALT_SCHEDULE_S3_URI=s3://nba-gestalt-data/nba-gestalt/schedule/model_track=updated_ratings_updated_minutes
Environment=GESTALT_GAME_CATALOG_PATH=/var/lib/nba-gestalt/catalog/games.parquet
EnvironmentFile=-/etc/nba-gestalt/dagster.env
ExecStart=/opt/nba-gestalt/current/.venv/bin/dagster-daemon run --workspace /var/lib/nba-gestalt/dagster/workspace.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
MemoryHigh=300M
MemoryMax=450M
Nice=5

[Install]
WantedBy=multi-user.target
