[Unit]
Description=NBA GESTALT Dagster daemon
After=network-online.target gestalt-web.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/nba-gestalt/current
Environment=PYTHONUNBUFFERED=1
Environment=DAGSTER_HOME=/var/lib/nba-gestalt/dagster
Environment=AWS_REGION=us-west-1
EnvironmentFile=-/etc/nba-gestalt/dagster.env
ExecStart=/opt/nba-gestalt/current/.venv/bin/dagster-daemon run --module-name nba_lineup_model.orchestration.definitions --working-directory /opt/nba-gestalt/current
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
MemoryHigh=700M
MemoryMax=900M
Nice=5

[Install]
WantedBy=multi-user.target
