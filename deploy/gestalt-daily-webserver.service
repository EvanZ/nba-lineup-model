[Unit]
Description=NBA GESTALT atomic daily pipeline Dagster UI
After=network-online.target gestalt-daily-code-server.service
Wants=network-online.target
Requires=gestalt-daily-code-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/nba-gestalt-daily/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/nba-gestalt-daily/current/src
Environment=DAGSTER_HOME=/var/lib/nba-gestalt/daily-dagster
Environment=AWS_REGION=us-west-1
Environment=GESTALT_DAILY_PIPELINE_CONFIG=/var/lib/nba-gestalt/daily-pipeline-v2/config.json
Environment=GESTALT_SCHEDULE_LOCK_PATH=/var/lib/nba-gestalt/.schedule-writer.lock
ExecStart=/opt/nba-gestalt-orchestration/current/bin/dagster-webserver --host 127.0.0.1 --port 3001 --workspace /var/lib/nba-gestalt/daily-dagster/workspace.yaml
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryHigh=250M
MemoryMax=400M
Nice=10

[Install]
WantedBy=multi-user.target
