[Unit]
Description=NBA GESTALT independent dev data-quality watchdog
After=network-online.target gestalt-web-dev.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=@WATCHDOG_PACKAGE@/code
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GESTALT_OPERATIONAL_REPORTS_S3_URI=s3://nba-gestalt-data/lake/operational-reports/environment=dev
Environment=PYTHONPATH=@WATCHDOG_PACKAGE@/code/src
ExecStart=@ORCHESTRATION_PYTHON@ -m nba_lineup_model.orchestration.data_quality_probe --watchdog-package-root @WATCHDOG_PACKAGE@ --watchdog-package-sha256 @WATCHDOG_SHA256@ --environment dev --live-release /var/lib/nba-gestalt-dev/live-release --schedule-root /var/lib/nba-gestalt/schedule-serving/current --dagster-home /var/lib/nba-gestalt/collection-dagster --daily-dagster-home /var/lib/nba-gestalt-dev/daily-dagster --daily-dagster-api-root http://127.0.0.1:3002 --api-root http://127.0.0.1:8011 --output-root /var/lib/nba-gestalt-dev/data-quality --thresholds /etc/nba-gestalt/data-quality-thresholds.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/var/lib/nba-gestalt
ReadWritePaths=/var/lib/nba-gestalt-dev/data-quality
# SQLite WAL readers need their normal shared-memory sidecars. Queries use mode=ro;
# keep database files themselves read-only while permitting SQLite coordination.
ReadWritePaths=/var/lib/nba-gestalt/collection-dagster/schedules
ReadWritePaths=/var/lib/nba-gestalt/collection-dagster/history
ReadWritePaths=/var/lib/nba-gestalt-dev/daily-dagster/schedules
ReadWritePaths=/var/lib/nba-gestalt-dev/daily-dagster/history
ReadOnlyPaths=/var/lib/nba-gestalt/collection-dagster/schedules/schedules.db /var/lib/nba-gestalt/collection-dagster/history/runs.db
ReadOnlyPaths=/var/lib/nba-gestalt-dev/daily-dagster/schedules/schedules.db /var/lib/nba-gestalt-dev/daily-dagster/history/runs.db

TimeoutStartSec=10min
