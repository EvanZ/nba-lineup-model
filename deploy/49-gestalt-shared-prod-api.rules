// Only the dedicated production daily publisher may restart the production API.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "gestalt-daily-prod" &&
        action.lookup("unit") === "gestalt-web.service" &&
        action.lookup("verb") === "restart") {
        return polkit.Result.YES;
    }
});
