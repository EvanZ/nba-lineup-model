[Unit]
Description=NBA GESTALT atomic daily pipeline Dagster daemon
After=network-online.target gestalt-web.service gestalt-daily-code-server.service
Wants=network-online.target
Requires=gestalt-daily-code-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/nba-gestalt-daily/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/nba-gestalt-daily/current/src
Environment=DAGSTER_HOME=/var/lib/nba-gestalt/daily-dagster
Environment=AWS_REGION=us-west-1
Environment=GESTALT_DAILY_PIPELINE_CONFIG=/var/lib/nba-gestalt/daily-pipeline-v2/config.json
Environment=GESTALT_SCHEDULE_LOCK_PATH=/var/lib/nba-gestalt/.schedule-writer.lock
ExecStartPre=/bin/bash -c 'for i in {1..30}; do timeout 1 bash -c "</dev/tcp/127.0.0.1/4002" && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/nba-gestalt/current/.venv/bin/dagster-daemon run --workspace /var/lib/nba-gestalt/daily-dagster/workspace.yaml
Restart=always
RestartSec=5
TimeoutStopSec=60
MemoryHigh=500M
MemoryMax=750M
Nice=10

[Install]
WantedBy=multi-user.target
