[Unit]
Description=NBA GESTALT development API
After=network.target gestalt-web.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/nba-gestalt/current
Environment=PYTHONUNBUFFERED=1
Environment=GESTALT_DAILY_PIPELINE_ROOT=/var/lib/nba-gestalt-dev/daily-pipeline
Environment=GESTALT_SCHEDULE_LOCK_PATH=/var/lib/nba-gestalt-dev/.schedule-writer.lock
Environment=PYTHONPATH=/home/ubuntu/nba-lineup-model/src
Environment=GESTALT_CURRENT_SEASON_SERVING_ROOT=/var/lib/nba-gestalt-dev/live-release/current-season-serving
Environment=GESTALT_CURRENT_SEASON_LINEUPS_ROOT=/var/lib/nba-gestalt-dev/live-release/current-season-lineups
Environment=GESTALT_SCHEDULE_STATE_DIR=/var/lib/nba-gestalt-dev/live-release/schedule
Environment=GESTALT_LIVE_SCORE_STATE_DIR=/var/lib/nba-gestalt/schedule-serving/current
Environment=GESTALT_GAME_CATALOG_PATH=/var/lib/nba-gestalt-dev/live-release/catalog/games.parquet
Environment=GESTALT_SITE_RELEASE_ROOT=/var/lib/nba-gestalt-dev/live-release/site-releases
EnvironmentFile=/var/lib/nba-gestalt-dev/live-release/site-release.env
ExecStart=/opt/nba-gestalt-web-dev/current/bin/uvicorn nba_lineup_model.web_api.app:app --host 127.0.0.1 --port 8011 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/var/lib/nba-gestalt
ReadWritePaths=/var/lib/nba-gestalt-dev

[Install]
WantedBy=multi-user.target
